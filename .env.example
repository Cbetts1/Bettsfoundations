# ============================================================
# Betts Foundations — Environment Configuration
# Copy this file to .env and fill in your real values
# NEVER commit .env to version control
# ============================================================

# --- App ---
FRONTEND_URL=https://bettsfoundations.org
NEXT_PUBLIC_API_URL=/api
ALLOWED_ORIGINS=https://bettsfoundations.org

# --- JWT ---
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# --- Stripe ---
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_REPLACE_ME
# Get from https://dashboard.stripe.com/webhooks (endpoint: https://bettsfoundations.org/api/orders/webhook)
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- OpenAI ---
# Get from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-REPLACE_ME

# --- Admin account (created by install.sh) ---
ADMIN_EMAIL=admin@bettsfoundations.org
ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
